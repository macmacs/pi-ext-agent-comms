#!/usr/bin/env bash
# Print one frontmatter value from a role file; empty output if it is absent.
#
#   scripts/role-field roles/builder.md model   # → litellm/claude-opus-5
#
# Same shape the coms extensions parse (extensions/coms.ts parseFrontmatter):
# a leading `---` fence, `key: value` lines, optional surrounding quotes.
# Exits 0 with no output when the file has no frontmatter or lacks the key, so
# callers can treat "unset" and "no frontmatter" identically.
set -euo pipefail

file="${1:?usage: role-field <role-file> <key>}"
key="${2:?usage: role-field <role-file> <key>}"
test -f "$file" || { echo "role-field: $file not found" >&2; exit 1; }

awk -v key="$key" '
  NR == 1        { if ($0 != "---") exit; inside = 1; next }
  inside && /^---[[:space:]]*$/ { exit }
  inside {
    idx = index($0, ":")
    if (idx < 2) next
    k = substr($0, 1, idx - 1)
    v = substr($0, idx + 1)
    gsub(/^[ \t]+|[ \t]+$/, "", k)
    gsub(/^[ \t]+|[ \t]+$/, "", v)
    if (k != key) next
    first = substr(v, 1, 1)
    last  = substr(v, length(v), 1)
    if (length(v) >= 2 && first == last && (first == "\"" || first == "\047"))
      v = substr(v, 2, length(v) - 2)
    print v
    exit
  }
' "$file"
